{
    "name": "gkbs/core",
    "description": "Shared core for GK Business Suite and Mobilfunkboerse Business Suite WordPress plugins.",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0-alpha.0",
    "require": {
        "php": "^8.2",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "league/container": "^4.2",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GKBS\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GKBS\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable"
}
